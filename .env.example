OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

MOCK_MODE=false
LOW_COST_MODE=true

RUN_LANGGRAPH=true
RUN_CREWAI=false
RUN_AUTOGEN=true

# A 7-day plan needs roughly 900-1,200 output tokens. Values around 500 truncate
# the JSON and make the run fall back (see README, "Known limitations").
MAX_OUTPUT_TOKENS=1500
MAX_RETRIES=1
REQUEST_TIMEOUT_SECONDS=30

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Optional: use this when pointing OpenAI-compatible clients to another endpoint.
OPENAI_BASE_URL=
